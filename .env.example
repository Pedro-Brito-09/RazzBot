# Copy to /etc/razzbot.env on the server (chmod 600, owned by root)
TOKEN=your_discord_bot_token_here
API_KEY=your_roblox_open_cloud_api_key_here
# Every command has a !dev_ twin that runs against this universe. The same
# Open Cloud key must cover both universes.
DEV_UNIVERSE_ID=7117693401
# Place used for Luau Execution, which is how the bot edits Community Maps/Ids
# and map/Daily Cup leaderboards -- those are Luau buffers, and the datastore
# API can read a buffer but never write one. The API key needs
# universe.place.luau-execution-session:write on this place.
LUAU_PLACE_ID=86832525327994
# The matching place inside DEV_UNIVERSE_ID, so the !dev_ twins work too.
DEV_LUAU_PLACE_ID=
# Optional override for the verification experience used by /link.
VERIFICATION_GAME_URL=https://www.roblox.com/games/start?placeId=120140749641241
# Channel for the 09:00 UTC Daily Cup rollover announcement.
DAILY_CUP_CHANNEL_ID=
# Role pinged by the Daily Cup map notification.
DAILY_CUP_ROLE_ID=
# Channel for tournament announcements: registration, check-in and results.
TOURNAMENT_CHANNEL_ID=
# Role pinged when registration opens and again when check-in starts.
TOURNAMENT_ROLE_ID=
# Challonge holds the bracket. The bot creates the tournament there, fills it
# once check-in closes, and pushes results back. Register an application at
# https://connect.challonge.com and copy its client ID and secret here -- the
# bot uses the client_credentials grant, which is scoped to the application
# plus its owner, so brackets belong to that Challonge account.
CHALLONGE_CLIENT_ID=
CHALLONGE_CLIENT_SECRET=
# The home server: the ONLY place /achievements and /sync are published, and
# the only thing registered per-guild. Leave it unset and those two stay
# global instead (still not user-installable). Every other command is global.
GUILD_ID=
