# Copy to /etc/razzbot.env on the server (chmod 600, owned by root)
TOKEN=your_discord_bot_token_here
API_KEY=your_roblox_open_cloud_api_key_here
# Every command has a !dev_ twin that runs against this universe. The same
# Open Cloud key must cover both universes.
DEV_UNIVERSE_ID=7117693401
# Optional override for the verification experience used by /link.
VERIFICATION_GAME_URL=https://www.roblox.com/games/start?placeId=120140749641241
# Channel for the 09:00 UTC Daily Cup rollover announcement.
DAILY_CUP_CHANNEL_ID=
# Role pinged by the Daily Cup map notification.
DAILY_CUP_ROLE_ID=
# The home server. Registers a guild-only copy of every command there, which
# updates instantly, and is the ONLY place /achievements and /sync are
# published. Leave it unset and those two fall back to being global.
# User-installable global commands are always registered as well.
GUILD_ID=
